# ── Database ────────────────────────────────────────────────────────────────
# Migrations/seed run as an owner role. The app runs as a *non-superuser* so
# that Row Level Security is actually enforced (superusers bypass RLS).
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus
APP_DATABASE_URL=postgresql://nexus_app:nexus_app@127.0.0.1:5432/nexus

# If you prefer the bundled Docker stack instead of a local Postgres,
# run `docker compose up -d` and use port 55432:
# DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:55432/nexus
# APP_DATABASE_URL=postgresql://nexus_app:nexus_app@127.0.0.1:55432/nexus

REDIS_URL=redis://127.0.0.1:56379

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=dev-only-change-me-to-32-bytes-of-random

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── Tenant defaults (see docs/01-architecture.md § Localisation) ─────────────
DEFAULT_CURRENCY=AED
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Dubai

# ── PII encryption (see docs/04-security.md) ────────────────────────────────
# Identity documents are encrypted at rest. Losing these keys makes every
# Emirates ID, passport and IBAN permanently unreadable — back them up.
PII_ENCRYPTION_KEYS={"1":"<run npm run keygen>"}
PII_ACTIVE_KEY_ID=1
PII_INDEX_KEY=<run npm run keygen>
TRUST_PROXY=false

# Encrypts database dumps. Without it, backup.mjs warns and writes plaintext.
BACKUP_ENCRYPTION_KEY=<run npm run keygen>
