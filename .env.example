# ── Database ────────────────────────────────────────────────────────────────
# Migrations/seed run as an owner role. The app runs as a *non-superuser* so
# that Row Level Security is actually enforced (superusers bypass RLS).
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus
APP_DATABASE_URL=postgresql://nexus_app:nexus_app@127.0.0.1:5432/nexus

# If you prefer the bundled Docker stack instead of a local Postgres,
# run `docker compose up -d` and use port 55432:
# DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:55432/nexus
# APP_DATABASE_URL=postgresql://nexus_app:nexus_app@127.0.0.1:55432/nexus

REDIS_URL=redis://127.0.0.1:56379

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=dev-only-change-me-to-32-bytes-of-random

# ── AI ──────────────────────────────────────────────────────────────────────
# The assistant at /assistant (FR-P06). Leave ANTHROPIC_API_KEY empty and the
# feature switches itself off honestly: the page explains that it is not
# configured and lists the figures it would answer from. It never guesses, and
# it never redirects you somewhere else without saying why.
ANTHROPIC_API_KEY=
# Priced in the cost cap below. An id this app does not have a price for is
# charged at the most expensive rate it knows, so an unrecognised model
# over-reports spend rather than silently spending unbudgeted.
AI_MODEL=claude-opus-5
# How hard the model works per question: low | medium | high | xhigh | max.
# This is the cost/quality knob. Default medium.
AI_EFFORT=medium
# HARD CEILING on assistant spend per tenant per calendar month, in USD.
# Enforced twice: before a question starts, and between tool rounds inside one
# question, so neither a busy month nor one runaway question can exceed it.
# Spend is accumulated from ai_messages.cost_micros — the same rows that are
# the audit trail, so an answer cannot exist without its cost being counted.
AI_MONTHLY_BUDGET_USD=20

# ── Tenant defaults (see docs/01-architecture.md § Localisation) ─────────────
DEFAULT_CURRENCY=AED
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Dubai

# ── PII encryption (see docs/04-security.md) ────────────────────────────────
# Identity documents are encrypted at rest. Losing these keys makes every
# Emirates ID, passport and IBAN permanently unreadable — back them up.
PII_ENCRYPTION_KEYS={"1":"<run npm run keygen>"}
PII_ACTIVE_KEY_ID=1
PII_INDEX_KEY=<run npm run keygen>

# ── Behind a proxy ──────────────────────────────────────────────────────────
# Whether X-Forwarded-For may be believed. It decides two things: which bucket
# the rate limiter counts a request into, and what lands in audit_log.ip_address.
#
# Leave it EMPTY. proxy.ts then derives the answer — on Vercel a proxy is in
# front by definition, so the header is trusted there and nowhere else. Setting
# it to "false" used to be the shipped default and was wrong in the unsafe
# direction: every request keyed the limiter as "local", so one attacker's 31
# login POSTs locked out the entire deployment and every audit row lost its IP.
#
# Set TRUST_PROXY=true explicitly only when something else terminates TLS in
# front of the app (nginx, Cloudflare). Never set it with nothing in front — a
# client can then forge its own address and walk past the limiter.
#
# The production boot gate in packages/core/src/security/config.ts still wants
# an explicit "true" on a deployed environment, so set it in the Vercel project
# rather than relying on the derived default.
TRUST_PROXY=

# How many trusted proxies sit in front, counted from the app outwards. The
# rightmost N-th entry of X-Forwarded-For is used, because everything to the
# left of what the outermost trusted hop wrote may have been invented by the
# client. 1 is right for Vercel alone; use 2 for a CDN in front of Vercel.
TRUST_PROXY_HOPS=1

# ── Backups ─────────────────────────────────────────────────────────────────

# Encrypts database dumps. Without it, backup.mjs REFUSES TO RUN — there is no
# plaintext path. It also refuses anything short, low-entropy, placeholder-
# shaped, or equal to the value published on the line below, so the example is
# documentation and never configuration.
BACKUP_ENCRYPTION_KEY=<run npm run keygen>

# Where the encrypted dumps land locally. Default ./backups
BACKUP_DIR=

# ── Offsite replication (S3-compatible: AWS, Cloudflare R2, Backblaze B2, MinIO)
#
# OFF unless BACKUP_S3_BUCKET is set, and ALL-OR-NOTHING once it is: with the
# bucket set, a missing variable is a hard error rather than a default, because
# a half-configured target is a backup that reports success and goes nowhere.
# When replication is configured and fails, `npm run backup` exits non-zero.
#
# A backup on the machine it protects is not offsite. It shares that machine's
# disk, its power supply and its ransomware. UAE real-estate records carry a
# 15-year retention obligation that local disk does not meet.
BACKUP_S3_BUCKET=

# ⚠ REGION AND ENDPOINT HAVE NO DEFAULT, DELIBERATELY. ⚠
#
# Open question Q-8 is unresolved: whether storing UAE personal data outside the
# UAE satisfies PDPL cross-border transfer rules for records under a 15-year
# in-UAE retention obligation. A backup is a complete copy of every party,
# salary and Emirates ID in the business, at rest, for fifteen years — so the
# question applies to this bucket at least as much as to the primary database.
#
# Choosing a non-UAE region is a decision with legal consequences. This codebase
# cannot make it and will not disguise it as a default, so you must type it out.
# Whoever sets these two lines is the person accepting that decision.
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=

BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional, for STS / assumed-role credentials.
BACKUP_S3_SESSION_TOKEN=

# Key prefix inside the bucket, e.g. "nexus/prod/". Default: bucket root.
BACKUP_S3_PREFIX=

# "true" for MinIO and other gateways that want host/bucket/key addressing.
# Leave empty for AWS-style bucket.host/key. No host sniffing — you say which.
BACKUP_S3_FORCE_PATH_STYLE=

# Optional, e.g. GLACIER_IR / DEEP_ARCHIVE on AWS. Note that a class with a
# multi-hour restore latency is fine for the 15-year tail and wrong for the
# most recent backup, which is the one you reach for during an incident.
BACKUP_S3_STORAGE_CLASS=

# How the replica is proven to have arrived. Default "download".
#   download  read the whole object back and compare SHA-256 end to end. The
#             only check that proves the offsite copy is restorable. Costs one
#             egress of the artefact per backup.
#   head      compare Content-Length, and the ETag when the provider returns a
#             plain MD5. Cheaper; proves an object of the right size exists.
BACKUP_S3_VERIFY=

# Socket timeout per S3 request, ms. Default 120000.
BACKUP_S3_TIMEOUT_MS=

# ── Retention ───────────────────────────────────────────────────────────────
#
# off | local | remote | both. Default "off": nothing is ever deleted until
# someone chooses this deliberately.
BACKUP_PRUNE=

# "true" plans the prune and reports it without deleting anything.
BACKUP_PRUNE_DRY_RUN=

# Operational tiers — tune these freely.
#   every backup for the last N days, then one per ISO week, then one per
#   calendar month, then one per calendar year.
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_WEEKS=26
BACKUP_RETENTION_MONTHLY_MONTHS=24

# The legal floor, in years. May be RAISED here; any value below 15 is refused,
# because the 15-year UAE real-estate retention obligation is not a tuning knob
# and a mistyped environment variable must not be able to delete evidence the
# business is required to be able to produce.
BACKUP_RETENTION_FLOOR_YEARS=15

# Demo affordances on the sign-in page (prefilled credentials + role picker).
#
# Deliberately EMPTY here, and deliberately not "true".
#
# next.config.ts loads this file as a runtime FALLBACK when .env is absent, so
# .env.example is not merely documentation — its values reach a running app.
# Setting it to true here made CI's production-mode `next start` refuse to boot,
# which is the boot gate working correctly and catching a real misconfiguration
# path: anything unsafe in this file ships wherever .env is missing.
#
# Set it in your own .env (gitignored) for local development.
NEXUS_DEMO_MODE=

# Bearer token Vercel Cron presents to /api/cron/*. Without it the endpoint is
# DISABLED rather than open — an unauthenticated trigger for every scheduled
# job is not an acceptable default.
CRON_SECRET=

# ── Where errors and alerts go ──────────────────────────────────────────────
# Both optional, both off here. Structured reports are always written to stdout
# for a log drain; set these to ALSO post them to a webhook.
#
# Validated at boot and FATAL if wrong (config.ts): a value that is not a valid
# http(s) URL, or plain http in production, refuses to start. The failure being
# guarded is silence — a typo'd webhook breaks nothing and delivers nothing, so
# the first sign that alerting never worked is the incident nobody was paged
# for. Refusing to boot is the cheaper way to find out.
#
# Treat both as SECRETS. For Slack, Discord and Better Stack the URL is the
# credential, which is why neither is echoed back by anything that reads them.
ERROR_SINK_URL=
# The same, for the events worth waking someone for: lockout, cross-tenant
# access attempts, recovery-code use, erasure, and PII key rotation.
ALERT_SINK_URL=

# ── Seeding ─────────────────────────────────────────────────────────────────
# The password every seeded account gets when DATABASE_URL does NOT point at
# localhost. Deliberately absent here, and deliberately not given a value:
# dotenv loads this file, and next.config.ts loads it as a runtime fallback, so
# any credential written here is a published credential.
#
# On a laptop the seed uses its built-in demo password and this is not needed.
# Anywhere else the seed refuses to run without it:
#
#   SEED_PASSWORD="$(npm run --silent keygen | head -1)" npm run db:seed
#
# Rotating it does NOT change passwords already in a database — it only changes
# what the next seed writes.
# SEED_PASSWORD=
